# AICTE Approval Portal — environment configuration (copy to .env; on a host, set these as environment variables)

# HTTP port for the combined API + UI server (most hosts set PORT themselves)
PORT=3000

# Behind a hosting proxy / load balancer, set the number of proxy hops (usually 1) so rate limits see the real client IP.
# TRUST_PROXY=1

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DATA_DIR.
# For Supabase, use the Session pooler connection string (Project Settings → Database → Connect, port 5432).
DATABASE_URL=
PGLITE_DATA_DIR=./data/pgdata

# --- Document storage -----------------------------------------------------
# Private local directory (never served statically). Supabase Storage adapter: awaiting configuration.
STORAGE_DIR=./data/storage

# Seed demo institutions and TEST accounts on start (development only). Set to false in any real deployment.
SEED_DEMO=true

# Local development only. Do not set NODE_ENV on a host: `npm start` sets production itself, and a production
# NODE_ENV during install skips the build tools.
NODE_ENV=development

# --- Background jobs ------------------------------------------------------
# Deadline / EVC follow-up sweep interval (ms) and supervisor escalation threshold (days). System policy, not APH.
# SWEEP_INTERVAL_MS=300000
# ESCALATE_AFTER_OVERDUE_DAYS=2
# DISABLE_SCHEDULER=false
# Other follow-up periods (EVC acknowledgement / report, expiry alerts) are stored in the database and changed
# under Operational settings (proposed by an administrator, authorised by a supervisor).
